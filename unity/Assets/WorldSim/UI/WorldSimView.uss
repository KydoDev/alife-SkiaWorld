/* G3 P1 shell in the Neon Abyss palette (docs/G3_PLAN.md, "Design reference"). Touch targets >= 44 px. */

.ws-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: column;
    background-color: #07080f;
    color: #e8fbff;
    -unity-font-definition: url("Fonts/PixelifySans.ttf");
    font-size: 18px;
}

.ws-hud {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 6px 12px;
    background-color: #0e0f1f;
    border-bottom-width: 2px;
    border-bottom-color: #2c3560;
}

.ws-title {
    color: #39f5e0;
    font-size: 22px;
    -unity-font-style: bold;
}

.ws-stats {
    color: #9fd8e0;
}

.ws-bar {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    padding: 4px 8px;
    background-color: #0e0f1f;
}

.ws-btn {
    min-height: 44px;
    min-width: 44px;
    margin: 3px;
    padding: 0 12px;
    background-color: #0e0f1f;
    color: #e8fbff;
    border-width: 2px;
    border-color: #2c3560;
    border-radius: 0;
}

.ws-btn:hover {
    border-color: #39f5e0;
}

.ws-btn:active {
    background-color: #2c3560;
}

.ws-btn:disabled {
    color: #2c3560;
}

.ws-btn--primary {
    background-color: #39f5e0;
    border-color: #39f5e0;
    color: #07080f;
}

.ws-btn--primary:active {
    background-color: #9fd8e0;
}

.ws-btn--square {
    padding: 0;
    width: 44px;
}

.ws-speed {
    min-width: 72px;
    -unity-text-align: middle-center;
    color: #9fd8e0;
}

.ws-seed {
    flex-direction: row;
    align-items: center;
    margin: 3px 3px 3px 12px;
}

.ws-seed > .unity-label {
    min-width: 0;
    margin-right: 6px;
    color: #9fd8e0;
}

.ws-seed .unity-base-text-field__input {
    min-height: 44px;
    min-width: 180px;
    background-color: #07080f;
    color: #e8fbff;
    border-width: 2px;
    border-color: #2c3560;
    border-radius: 0;
}

/* No padding or border here: WorldCamera takes taps in element-local units against the content size. */
.ws-world {
    flex-grow: 1;
    background-color: #000000;
    overflow: hidden;
}

/* The world texture, drawn once; WorldSimView places it (centred, or panned and clamped). */
.ws-world-image {
    position: absolute;
}

.ws-error {
    position: absolute;
    left: 8px;
    top: 8px;
    right: 8px;
    color: #ff3fd1;
    white-space: normal;
    display: none;
}

.ws-dock {
    padding: 4px 8px;
    background-color: #0e0f1f;
    border-top-width: 2px;
    border-top-color: #2c3560;
}

.ws-tools {
    flex-direction: row;
    flex-wrap: wrap;
}

.ws-tool {
    flex-grow: 1;
}

.ws-tool--on {
    background-color: #ff3fd1;
    border-color: #ff3fd1;
    color: #07080f;
}

.ws-status {
    color: #9fd8e0;
    white-space: normal;
    padding: 2px 4px;
}

/* Portrait phones: the controls wrap and the title gives way to the numbers. */
.ws-portrait .ws-title {
    font-size: 18px;
}

.ws-portrait .ws-seed .unity-base-text-field__input {
    min-width: 120px;
}

/* G3 P6a cell sheet: a bottom sheet over the dock; bars in two columns. */
.ws-sheet {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 55%;
    padding: 6px 12px 10px 12px;
    background-color: rgba(14, 15, 31, 0.94);
    border-top-width: 2px;
    border-top-color: #39f5e0;
    display: none;
}

.ws-sheet--open {
    display: flex;
}

.ws-sheet__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.ws-sheet__title {
    color: #39f5e0;
    font-size: 20px;
    -unity-font-style: bold;
}

.ws-sheet__text {
    color: #e8fbff;
    white-space: normal;
    margin-bottom: 4px;
}

.ws-sheet__bars {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 4px;
}

.ws-bar-row {
    flex-direction: row;
    align-items: center;
    width: 50%;
    min-width: 220px;
    height: 20px;
}

.ws-bar-row__name {
    width: 96px;
    font-size: 14px;
    color: #9fd8e0;
}

.ws-bar-row__track {
    flex-grow: 1;
    height: 8px;
    margin-right: 12px;
    background-color: #2c3560;
}

.ws-bar-row__fill {
    height: 100%;
    background-color: #39f5e0;
}

/* the selected tile: an outline the view places over it */
.ws-marker {
    position: absolute;
    border-width: 2px;
    border-color: #ffffff;
}

/* G3 P6b population panel: counts per kind and a chart, toggled by the Population button. */
.ws-pop {
    position: absolute;
    right: 8px;
    top: 120px;
    width: 340px;
    padding: 8px;
    background-color: rgba(14, 15, 31, 0.94);
    border-width: 2px;
    border-color: #2c3560;
    display: none;
}

.ws-pop--open {
    display: flex;
}

.ws-pop__counts {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.ws-pop__count {
    font-size: 16px;
}

.ws-pop__chart {
    height: 150px;
    background-color: #07080f;
}

/* G3 P7: a tool the energy cannot pay for (still pickable: the energy regenerates) */
.ws-tool--poor {
    opacity: 0.45;
}

/* G3 P7: milestone toast, over the top of the world */
.ws-toast {
    position: absolute;
    top: 120px;
    left: 24px;
    right: 24px;
    padding: 10px 14px;
    background-color: rgba(14, 15, 31, 0.94);
    border-width: 2px;
    border-color: #ff3fd1;
    color: #ffffff;
    font-size: 20px;
    white-space: normal;
    -unity-text-align: middle-center;
    display: none;
}

.ws-toast--on {
    display: flex;
}

/* G3 P8: species drawer (shares .ws-pop's frame; the population panel and it close each other) */
.ws-species__header {
    font-size: 16px;
    white-space: normal;
    margin-bottom: 6px;
}

.ws-species__rows {
    max-height: 300px;
}

.ws-species__row {
    font-size: 16px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 2px 4px;
}

.ws-species__row--picked {
    background-color: #2c3560;
}

.ws-species__ancestry {
    font-size: 15px;
    white-space: normal;
    margin-top: 6px;
    color: #c8d0ff;
}
